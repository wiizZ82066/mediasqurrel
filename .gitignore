# ============================================================
# 白名单模式：默认忽略根目录所有内容，仅放行代码与文档。
# 原因：本目录同时存放个人媒体存档（<作者>/<日期>/视频、图片），
# 绝不能进入 git（公开到 GitHub）。
#
# 新增顶层脚本(.py)时：在下方【放行区】加一行 "!/脚本名.py"
# 新增代码目录时：加 "!/目录名/" 和 "!/目录名/**"
# ============================================================

# 忽略一切
/*

# ---------- 放行区 ----------
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/DESIGN.md
!/README.md
!/CURRENT_BASELINE.md
!/RELEASE_AUDIT.md
!/BUILD_SIZE_REPORT.md
!/RELEASE_TEST_REPORT.md
!/RELEASE_FINAL_REPORT.md
!/RELEASE_UPDATE_TEST.md
!/RELEASE_FRAMEWORK_UPGRADE.md
!/requirements.txt
!/requirements-release.txt
!/weibo_downloader.py
!/douyin_downloader.py
!/run.py
!/make_icon.py
!/build_backend.ps1
!/package.json
!/package-lock.json
!/app/
!/app/**
!/scripts_manifest/
!/scripts_manifest/**
!/frontend/
!/frontend/**
!/electron/
!/electron/**
# ---------- 放行区结束 ----------

# 放行目录内部的常规排除
frontend/node_modules/
frontend/dist/
app_data/
.npm-cache/
__pycache__/
*.py[cod]
.venv/
*.log
.agent-browser/

# 桌面打包产物（Electron / PyInstaller）
backend-dist/
build/
dist/
release/
portable/
*.spec
node_modules/

# 更新签名私钥（只允许存在于 CI secret / 本机，绝不入库）
update-private-key.pem
*.pem
*.pfx
*.key
