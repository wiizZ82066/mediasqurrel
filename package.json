{
  "name": "media-squirrel",
  "productName": "Media Squirrel",
  "version": "1.1.1",
  "private": true,
  "description": "本地媒体下载管理平台（微博/抖音 下载·订阅·媒体库）",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icon": "python make_icon.py",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File build_backend.ps1",
    "desktop:dev": "concurrently -k -n backend,vite,electron -c blue,green,yellow \"python run.py --no-browser --no-tray\" \"cd frontend && npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:preview": "npm run build:frontend && npm run build:backend && electron .",
    "desktop:build": "npm run icon && npm run build:frontend && npm run build:backend && electron-builder --win nsis --x64",
    "desktop:build:dir": "npm run icon && npm run build:frontend && npm run build:backend && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  },
  "build": {
    "appId": "com.mediasquirrel.app",
    "productName": "Media Squirrel",
    "copyright": "MIT License",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**",
      "!electron/tests/**",
      "package.json",
      "node_modules/electron-updater/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/MediaSquirrelBackend",
        "to": "backend/MediaSquirrelBackend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend-dist/playwright-browsers",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Media Squirrel",
      "artifactName": "Media-Squirrel-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wiizZ82066",
        "repo": "mediasqurrel"
      }
    ]
  }
}
