{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Squirrel",
  "version": "0.1.0",
  "identifier": "com.mediasquirrel.app",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Squirrel",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../backend-dist/media-squirrel-backend": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
